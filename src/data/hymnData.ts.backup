// 1~645 새찬송가 자동생성기
function generateNewHymns(): Hymn[] {
  const list: Hymn[] = [];

  for (let num = 1; num <= 645; num++) {
    if (KNOWN_NEW_HYMNS[num]) {
      const known = KNOWN_NEW_HYMNS[num];
      list.push({
        id: `new-${num}`,
        number: num,
        type: 'new',
        title: known.title,
        category: known.category,
        key: known.key,
        scriptureRef: known.scriptureRef,
        verses: known.verses,
        chorus: known.chorus,
      });
    } else {
      const title = ALL_HYMN_TITLES[num] || `새찬송가 ${num}장`;
      const category = CATEGORIES[num % CATEGORIES.length];
      const key = KEYS[num % KEYS.length];

      list.push({
        id: `new-${num}`,
        number: num,
        type: 'new',
        title: title,
        category: category,
        key: key,
        scriptureRef: `시편 ${((num * 7) % 150) + 1}:${(num % 20) + 1}`,
        verses: [
          `1절: ${title}`,
          `💡 상단의 [가사 수정/보완] 버튼을 클릭하시면 찬송가 가사를 직접 등록/수정하실 수 있습니다.`,
          `💡 상단의 [유튜브 찬양/MR 감상] 버튼을 클릭하시면 전체 가사와 오케스트라 찬양 영상 및 악보를 바로 감상하실 수 있습니다.`,
        ],
      });
    }
  }

  return list;
}

